# Optional build options read by consulting-ppt-white-ppt (lib/consult_helpers.js and
# examples/build_sample.js) through process.env. Nothing here is a secret, and no script loads
# this file: export a variable in the shell that runs the build.

# Brand accent hex without '#', usually the output of tools/extract_brand_color.py (default FB0050)
# ACCENT=

# Path to the customer logo image for the cover, divider, and footer badge (default: a text chip)
# LOGO=

# Output file name for examples/build_sample.js (default WADD_Consulting_Style_Sample.pptx)
# OUT=
