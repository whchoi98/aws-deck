root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# Harness shell scripts use 4 spaces; the plugin's own shell scripts use 2
[{.claude,scripts,tests}/**.sh]
indent_size = 4

[Makefile]
indent_style = tab
